generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

/// Archive-wide values: the source identity, and the settings (integrations, retention).
model Setting {
  key   String @id
  value Json

  @@map("settings")
}

/// One session. `summary` is its listing (snapshot metadata, tags as captured, models,
/// references, suggestions), recomputed on capture and when settings change.
model Archive {
  id         String  @id
  /// Insertion order: listings are newest first.
  seq        BigInt  @unique @default(autoincrement())
  /// The snapshot as its writer sent it: head, ingest and previousDigest speak this digest.
  digest     String
  /// The current revision as stored here and published onward. Differs from `digest` only when
  /// ingest filtered the snapshot (captureToolCallsAndResults off).
  storedDigest String
  revision   Int
  source     String
  projectId  String?
  actorId    String?
  /// The model provider (anthropic, openai) and the access path (subscription, api, unknown).
  provider   String?
  accessPath String?
  capturedAt Float
  summary    Json
  /// A raw capture of a session its driver later stored itself: kept, never delivered onward.
  supersededBy String?
  /// The incoming transcript without collector additions (`transcriptDigest`), for tombstones.
  transcriptDigest String?

  revisions  Revision[]
  tagEdits   TagEdit[]
  suggestion Suggestion?
  receipts   Receipt[]
  outbox     Outbox[]

  @@index([projectId])
  @@index([actorId])
  @@index([provider])
  @@index([accessPath])
  @@map("archives")
}

/// A session deleted here (by `delete` or retention): its key and the writer's digest, so a
/// collector that finds the same unchanged source file sees it as unchanged and does not import it
/// again. A capture with another digest (the session resumed) brings the session back.
model ArchiveTombstone {
  id               String   @id
  /// The writer's digest as last seen: what `head` answers.
  digest           String
  /// The transcript's own digest: a capture of the same transcript stays deleted however it is
  /// tagged. Null for a session captured before 0.23.0 (then only `digest` matches).
  transcriptDigest String?
  projectId        String?
  deletedAt        DateTime @default(now())

  @@map("archive_tombstones")
}

/// An immutable revision of a session. Only the current one is kept, plus one an outbox row
/// still names until it is delivered (compaction).
model Revision {
  archiveId String
  revision  Int
  /// The digest of this revision's snapshot as stored.
  digest    String
  snapshot  Json

  archive Archive @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  chunks  Chunk[]

  @@id([archiveId, revision])
  @@map("revisions")
}

/// Lossless text chunks of a revision, in order, for search.
model Chunk {
  archiveId  String
  revision   Int
  position   Int
  id         String
  entryId    String
  sourceRef  String
  kind       String
  start      Int
  end        Int
  text       String
  tokenCount Int
  /// Reserved for semantic search; nothing writes it yet.
  embedding  Unsupported("vector(1536)")?

  revisionRef Revision @relation(fields: [archiveId, revision], references: [archiveId, revision], onDelete: Cascade)

  @@id([archiveId, revision, position])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("chunks")
}

/// A tag added (added = true) or removed from what the session was captured with.
model TagEdit {
  archiveId String
  tag       String
  added     Boolean

  archive Archive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@id([archiveId, tag])
  @@map("tag_edits")
}

/// The tagger's suggestions for one digest of an archive: defined category tags, `junk`, and
/// `project:<id>` when routing was weak. Never applied; a person applies or removes tags.
model Suggestion {
  archiveId String   @id
  /// The archive digest the suggestions describe; a new digest makes them due again.
  digest    String
  /// The tagger's prompt, model and tag definitions, hashed; a change makes them due again.
  /// New projects do not: `suggest --refresh` asks again.
  key       String
  /// The model that suggested.
  by        String
  tags      String[]
  at        Float

  archive Archive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@map("suggestions")
}

/// A tag this archive offers: archive-wide (actorId "") or for one actor.
model TagDefinition {
  actorId     String
  tag         String
  description String?

  @@id([actorId, tag])
  @@map("tag_definitions")
}

/// The digest a destination last acknowledged.
model Receipt {
  archiveId   String
  destination String
  digest      String

  archive Archive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@id([archiveId, destination])
  @@map("receipts")
}

/// A revision queued for a destination.
model Outbox {
  archiveId   String
  destination String
  revision    Int

  archive Archive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@id([archiveId, destination])
  @@map("outbox")
}

/// A writer that records native sessions itself (Foundry, for the threads it drives) claims them
/// with a lease. The collector skips a claimed session while the lease is live, or once the claim
/// is fulfilled (the writer stored its own version of it, `fulfilledBy`). A lapsed, unfulfilled
/// claim (the writer died) falls back to capturing the raw session: every session is kept.
model Claim {
  source      String
  sessionId   String
  claimant    String
  expiresAt   DateTime
  /// The archive that covers this session, once the claimant stored it, and when: the transcript as
  /// it was then. A later change with no live lease is captured raw.
  fulfilledBy String?
  fulfilledAt DateTime?
  updatedAt   DateTime @updatedAt

  @@id([source, sessionId])
  @@map("claims")
}
